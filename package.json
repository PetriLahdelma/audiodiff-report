{
  "name": "audiodiff-report",
  "version": "0.1.0",
  "description": "Alignment-aware audio diff reports with CI gating and producer-friendly metrics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetriLahdelma/audiodiff-report.git"
  },
  "homepage": "https://github.com/PetriLahdelma/audiodiff-report#readme",
  "bugs": {
    "url": "https://github.com/PetriLahdelma/audiodiff-report/issues"
  },
  "keywords": [
    "audio",
    "diff",
    "report",
    "ci",
    "lufs",
    "waveform"
  ],
  "type": "module",
  "bin": {
    "audiodiff-report": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".github/actions/audiodiff-report"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "brand:build": "node scripts/brand-build.mjs",
    "brand:screenshots": "node scripts/brand-screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "audio-decode": "2.2.3",
    "commander": "11.1.0",
    "fast-glob": "3.3.2",
    "fft.js": "4.0.4"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "typescript": "5.4.5",
    "vitest": "1.4.0",
    "svgo": "^3.3.2",
    "sharp": "^0.33.5"
  }
}
