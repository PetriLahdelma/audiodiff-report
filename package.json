{
  "name": "audiodiff-report",
  "version": "0.1.0",
  "description": "Alignment-aware audio diff reports with CI gating and producer-friendly metrics.",
  "type": "module",
  "bin": {
    "audiodiff-report": "dist/cli.js"
  },
